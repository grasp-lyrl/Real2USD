# ROS2 workspace
humble_ws/build
humble_ws/install
humble_ws/log

# External Meta SAM3D fork clone (its own git repo + gated ~13GB checkpoints; see
# real2sam3d/sam3d_setup.sh to (re)create). Never vendored into this repo.
humble_ws/src_Real2USD/real2sam3d/sam-3d-objects/

# Gemini API key
humble_ws/src_Real2USD/real2usd/config/gemini_key.py
humble_ws/src_Real2USD/real2sam3d/config/gemini_key.py

# Models
models/
mobileclip_blt.ts

# Evaluation data
humble_ws/evaluations/results/
humble_ws/evaluations/pc_data/
humble_ws/evaluations/clio/
humble_ws/evaluations/supervisely/
humble_ws/evaluations/usda/
humble_ws/evaluations/odom/
humble_ws/video_frames/
humble_ws/evaluations/timing_results/
humble_ws/evaluations/chairs/

humble_ws/vggt_evaluation*

# System files
.sudo_as_admin_successful
.bash_history
.ssh
tmp
data
.cache
.local
.ros
.vscode

# The bare `data` rule above (dataset dirs) also matches the r2s3d_core source
# package literally named `data/` (the SequenceSource backends). Re-include it so the
# backends are tracked — without this a fresh clone has no dataset adapters.
!/humble_ws/src_Real2USD/r2s3d_core/src/r2s3d_core/data/
!/humble_ws/src_Real2USD/r2s3d_core/src/r2s3d_core/data/*.py

# SAM3D disk-queue contents are regenerable scratch (per-job meta/rgb/mask/depth +
# generated meshes). Keep only the run.json records under results/<exp>/.
sam3d_queue/

# User data directory (all hidden files go here via HOME=/home/me/tmp)
humble_ws/tmp
*.log
*.egg-info/
__pycache__/

